# Required — OpenAI (story + still illustrations)
OPENAI_API_KEY=sk-...

# Video provider (pick one or more; auto selects first available)
# Luma Dream Machine — https://platform.lumalabs.ai/
LUMA_API_KEY=

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Optional model override, e.g. minimax/video-01 or bytedance/seedance-1-pro
# REPLICATE_VIDEO_MODEL=minimax/video-01

# Runway — https://dev.runwayml.com/
RUNWAYML_API_SECRET=
# RUNWAY_MODEL=gen4_turbo

# Force a provider: auto | luma | replicate | runway | off
VIDEO_PROVIDER=auto

# If you expose the server publicly (ngrok, etc.), set this so image-to-video can use the still
# PUBLIC_BASE_URL=https://your-public-host.example

PORT=3000
